# Base URL of the NexaGo API. Point this at your deployed backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Google Maps (rider map + route polyline).
# Without a key the app falls back to OpenStreetMap tiles via Leaflet so local
# development and previews still render a usable map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a real Map ID from the Google Cloud console. Defaults to Google's
# DEMO_MAP_ID, which is fine for development but not for production billing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Sign-In (Google Identity Services). The button stays disabled until
# this is set; the backend must expose POST auth/google to verify the ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
